{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "Devuelve la temperatura dada una localización.",
  "properties": {
    "location": {
      "type": "string",
      "description": "¿Qué temperatura hace en (e.j. \"New York\")?"
    },
    "units": {
      "type": "string",
      "description": "La temperatura puede ser en \"fahrenheit\" o \"celsius\"). Default: \"celsius\".",
      "enum": ["fahrenheit", "celsius"]
    }
  },
  "required": ["location"],
  "additionalProperties": false
}